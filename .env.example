# Copy this file to .env (same folder as manage.py) and fill in what you need; restart Django after editing.
# This file is git-ignored. Variables already set in the process environment take priority over .env.
# Never commit real values.

# The app and database run locally. Add your own SMTP and Gemini credentials
# only if you want verification emails and AI suggestions.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DJANGO_USE_UNPOOLED_DATABASE=false
DB_ENGINE=django.db.backends.sqlite3

# SMTP: replace these with the settings from your email provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Gemini: add your own API key. Without a key, the app uses Table 17 fallback values.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_GROUNDING=url

# Optional demo accounts; set these locally, then run:
# python manage.py provision_test_users --confirm
# GUIOS_TEST_ADMIN_EMAIL=
# GUIOS_TEST_ADMIN_PASSWORD=
# GUIOS_TEST_DECISOR_EMAIL=
# GUIOS_TEST_DECISOR_PASSWORD=
# GUIOS_TEST_ADMIN_FIRST_NAME=Administrador
# GUIOS_TEST_DECISOR_FIRST_NAME=Decisor

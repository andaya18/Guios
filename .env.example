# Copy this file to .env (same folder as manage.py) and fill in what you need; restart the server after editing.
# .env is git-ignored. Variables already set in the system or hosting dashboard take priority over .env.
# Never commit real values.

# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=guios-pro.onrender.com

# Database: leave unset to use SQLite (db.sqlite3) in development.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=guios
# DB_USER=guios
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email: the console backend prints verification codes in the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=GUIOS PRO <no-reply@example.com>

# AI: suggested importance (IS) computed from literature citations verified by Gemini.
# Without AI_PROVIDER and AI_API_KEY the system uses the fallback values (Table 17) and says so on screen.
# Get a key at https://aistudio.google.com/apikey . A Gemini 3+ model is required (web tools + JSON output).
AI_PROVIDER=disabled
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-3-flash-preview
# AI_TIMEOUT_SECONDS=90
# AI_TEMPERATURE=0
# url: reads each DOI page plus OpenAlex/Crossref/Semantic Scholar records (works on the free tier).
# search: Google Search grounding (requires a billed Google Cloud project).
# AI_GROUNDING=url
# Expert importance (IE) of the thesis, fixed at 3.
# LITERATURE_EXPERT_IMPORTANCE=3

# Copy this file to .env and replace the empty values with your own credentials.
# Never commit .env or share its contents.
# The database is local SQLite; no database credentials are needed.

# Gmail SMTP example. Replace the host and port if your provider differs.
# For Gmail, use an app password instead of your normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Gemini API key. Without a key, the app uses Table 17 fallback values.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_GROUNDING=url

# Settings are read from environment variables (no .env loader is installed).
# Set them in the hosting dashboard, or in PowerShell: $env:AI_PROVIDER="disabled"
# Never commit real values.

# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=guios-pro.onrender.com

# Database: leave unset to use SQLite (db.sqlite3) in development.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=guios
# DB_USER=guios
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email: the console backend prints verification codes in the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=GUIOS PRO <no-reply@example.com>

# AI suggestions (optional). Disabled unless both provider and key are set.
AI_PROVIDER=disabled
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_SECONDS=20
